DATABASE_URL=mysql+aiomysql://accord:change-this-password@127.0.0.1:3306/accord
ENVIRONMENT=development

# Optional: leave blank to use the local payment simulation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local Ollama agent assistance (never authorizes or executes payments).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b

# Development-only demo catalog/transactions. Set false for a clean local DB.
DEMO_DATA=true
